<?xml version="1.0" encoding="utf-8"?><!--
   Правила резервного копирования и переноса на другое устройство для Android 12 и новее.
   Для старых версий те же правила продублированы в backup_rules.xml.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!--
       PIN от посохов (PinStore, файл staff-pins.xml) не уезжает ни в облачную копию,
       ни на новое устройство при переносе: PIN должен оставаться на этом планшете,
       на новом его один раз вводят заново. Есть только exclude, без include:
       всё остальное (база бросков, персонажи) копируется, как и раньше.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="staff-pins.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="staff-pins.xml" />
    </device-transfer>
</data-extraction-rules>
