<?xml version="1.0" encoding="utf-8"?><!--
   Правила резервного копирования для Android 11 и старше (на Android 12+ действуют
   правила из data_extraction_rules.xml). Планшет на Android 10 берёт именно этот файл.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
       PIN от посохов (PinStore, файл staff-pins.xml) в копию не кладём: копия уезжает
       из личной папки приложения в облако и на другие устройства, а PIN должен оставаться
       на этом планшете. После восстановления PIN один раз вводится заново.
       Есть только exclude, без include: всё остальное (база бросков, персонажи)
       копируется, как и раньше.
    -->
    <exclude domain="sharedpref" path="staff-pins.xml" />
</full-backup-content>
