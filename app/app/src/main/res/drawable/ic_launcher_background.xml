<?xml version="1.0" encoding="utf-8"?>
<!--
    Фон адаптивной иконки: сплошная заливка цветом рамки пиксельного рисунка (#070C14).
    Сам рисунок лежит в переднем слое и занимает центральные 72 dp из 108, то есть
    безопасную зону, которую маска лаунчера не обрезает ни при какой форме значка.
    Совпадение цвета с углами рисунка делает стык невидимым.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#070C14"
        android:pathData="M0,0h108v108h-108z" />
</vector>
